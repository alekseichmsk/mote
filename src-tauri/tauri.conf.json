{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mote",
  "version": "0.1.0",
  "identifier": "com.mote.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Mote",
        "width": 360,
        "height": 280,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* asset: https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/dictionaries/ru_RU/ru_RU.aff",
      "resources/dictionaries/ru_RU/ru_RU.dic",
      "resources/dictionaries/en_US/en_US.aff",
      "resources/dictionaries/en_US/en_US.dic"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3MEY2MzEzMzAzMENBNTYKUldSV3lqQXdFMk1QZCtuQmdNY2xzVVdnOUUvbUc2V2ovTThGNmlpMFRqempBRlR6MEh6ZENSdisK",
      "endpoints": [
        "https://github.com/alekseichmsk/mote/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
